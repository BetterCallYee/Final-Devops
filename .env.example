# OpenClaw Gateway Security Token
# Generate a new token using: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
OPENCLAW_GATEWAY_TOKEN=6fb2bb07f86145609f27b3a44a19692947f37c7b9dbc46c483991951f6ac6b0b

# Network Port Bindings
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790

# Gateway Network Binding ('lan' or 'loopback')
OPENCLAW_GATEWAY_BIND=lan

# Docker Image Tag
OPENCLAW_IMAGE=openclaw:local

# Container Timezone
OPENCLAW_TZ=Asia/Bangkok
